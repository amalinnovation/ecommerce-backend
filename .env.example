# Copiar a .env y completar. Nunca comitear .env real.

PORT=3000

# Postgres — vía el pooler de Supabase en modo transacción (puerto 6543).
# En local, `supabase start` imprime la URL de conexión local.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# webpay | flow | fake — ver checkout.module.ts
PAYMENT_PROVIDER=fake

# Firma la cookie httpOnly del visitante anónimo. Mínimo 32 caracteres.
COOKIE_SECRET=
